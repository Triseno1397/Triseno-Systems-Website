# ─────────────────────────────────────────────────────────────────────────────
# Triseno CMS (/edit) — environment
#
# Set these in Vercel → Project → Settings → Environment Variables (Production).
# Every one of them is SERVER-ONLY. None may ever be prefixed NEXT_PUBLIC_, and none
# may be put in next.config.ts's `env` key — that inlines values into the client
# bundle, which would publish the GitHub token to every visitor.
#
# Until these are set, /edit simply 404s and the login endpoint returns 503. The public
# site is completely unaffected either way.
# ─────────────────────────────────────────────────────────────────────────────

# ── Editor access ────────────────────────────────────────────────────────────
# The PIN, scrypt-hashed. Never stored in plaintext, never committed.
# Regenerate for a new PIN:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('EDIT_PIN_SALT='+s);console.log('EDIT_PIN_HASH='+c.scryptSync('YOUR_PIN',s,64).toString('hex'))"
EDIT_PIN_SALT=
EDIT_PIN_HASH=

# Signs the session cookie. 32+ random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EDIT_SESSION_SECRET=

# The unlock key. /edit is unreachable — it 404s — until someone visits
#   https://trisenosystems.com/edit/unlock?k=<this value>
# once, which drops a long-lived cookie. Bookmark that link.
#
# This is what makes a 4-digit PIN defensible: an attacker cannot even reach the PIN
# form without first guessing 128 bits. Treat it like a password.
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
EDIT_UNLOCK_KEY=

# ── Publishing ───────────────────────────────────────────────────────────────
# A GitHub fine-grained personal access token, scoped to ONLY
# Triseno1397/Triseno-Systems-Website, with a single permission: Contents → Read & write.
# Nothing else. Publishing commits src/content/*.json to main; Vercel deploys it.
#
# NOTE: fine-grained tokens expire. When it does, Publish will start failing with a 401
# and nothing else will break. Put its expiry in a calendar.
GITHUB_TOKEN=

# ── Draft storage (Upstash Redis — free tier) ────────────────────────────────
# Holds the in-progress draft, the publish lock, and the login lockout counters.
# Optional for local dev (an in-memory fallback is used, and the editor shows a
# "Drafts not saved to server" badge), but REQUIRED in production: without it, a draft
# lives only in one lambda's memory and vanishes when that lambda goes cold.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Local development only ───────────────────────────────────────────────────
# Drops the __Host- cookie prefix and the Secure flag so the session works over
# http://localhost. MUST NOT be set in production — it downgrades the session cookie.
# CMS_INSECURE_COOKIES=1
